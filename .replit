entrypoint = "README.md"
modules = ["nodejs-22", "node", "postgresql-16", "python-3.11", "javascript"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 4200

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3002

[[ports]]
localPort = 9999
externalPort = 5173

[env]
PORT = "5000"

[agent]
stack = "EXPO"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "body-diagram-fill-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "body-diagram-contracts"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "body-diagram-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "prehab-regions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "body-diagram"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "conditioning-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "custom-session-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 METRO_PORT=8082 npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN npx expo start --port 8082 --localhost"

[[workflows.workflow]]
name = "body-diagram-fill-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/check-body-diagram-fill.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "body-diagram-contracts"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node tests/body-diagram.check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "body-diagram-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node -r ./jest-mock-polyfill.js node_modules/.bin/jest --config jest-component.config.js --forceExit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "prehab-regions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node tests/prehab-regions.check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "body-diagram"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node tests/body-diagram.check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "conditioning-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node tests/conditioning.check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "custom-session-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node tests/custom-session.check.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[userenv]

[userenv.development]

[userenv.shared]

[userenv.production]
EXPO_PUBLIC_DOMAIN = "grow-performance-rehab.replit.app"
EXPO_PUBLIC_REVENUECAT_API_KEY = "appl_ilJIJJRfMXJvKPykaYebIuYblXC"
